{
  "name": "flowcast-prototype",
  "version": "0.4.1",
  "license": "MIT",
  "description": "FlowCast Windows and Android continuous recording",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:desktop:packaged": "node scripts/desktop-smoke.mjs --packaged",
    "pack:win": "electron-builder --win --dir",
    "test:scanner": "node scripts/scanner-smoke.mjs",
    "remote:start": "node remote/hub.mjs",
    "test:remote:browser": "node scripts/browser-smoke.mjs --remote",
    "build:icons": "node scripts/build-icons.mjs",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "dev.flowcast.studio",
    "productName": "FlowCast",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "lib/**/*",
      "server.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/flowcast.ico"
    },
    "artifactName": "FlowCast-${version}-${arch}.${ext}",
    "nsis": {
      "artifactName": "FlowCast-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FlowCast",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "packElevateHelper": false
    },
    "electronDist": "node_modules/electron/dist"
  },
  "author": "FlowCast",
  "private": true
}
